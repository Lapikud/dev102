---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkshopCard from "../../components/WorkshopCard.astro";
import { getUpcomingWorkshops, getPastWorkshops } from "../../lib/workshops.ts";

const workshops = await getCollection("workshops");
const upcoming = getUpcomingWorkshops(workshops);
const past = getPastWorkshops(workshops);
---

<SiteLayout pageTitle="Workshops">
  <div class="workshops-page">
    <header class="intro">
      <h1 class="terminal-token">~#DEV102/workshops</h1>
      <p>
        Hands-on sessions for learning, sharing, and making things together.
      </p>
    </header>

    <section aria-labelledby="workshops-heading">
      <h2 id="workshops-heading" class="section-heading label">
        !#workshops :
      </h2>
      {workshops.length > 0 ? (
        <workshop-list class="workshop-list">
          {[...upcoming, ...past].map((workshop) => (
            <WorkshopCard
              workshop={workshop}
              isNext={workshop === upcoming[0]}
            />
          ))}
        </workshop-list>
      ) : (
        <p class="panel panel-body label">No workshops yet. Check back soon.</p>
      )}
    </section>
  </div>
</SiteLayout>

<script>
  import { isWorkshopOver } from "../../lib/workshops.ts";

  class WorkshopList extends HTMLElement {
    connectedCallback() {
      const cards = [...this.querySelectorAll<HTMLElement>("[data-starts]")];
      const startOf = (card: HTMLElement) => Date.parse(card.dataset.starts!);
      const live = cards
        .filter((card) => !isWorkshopOver(new Date(card.dataset.starts!)))
        .sort((a, b) => startOf(a) - startOf(b));
      const over = cards
        .filter((card) => !live.includes(card))
        .sort((a, b) => startOf(b) - startOf(a));
      this.append(...live, ...over);
      for (const card of cards)
        card.toggleAttribute("data-next", card === live[0]);
    }
  }

  customElements.define("workshop-list", WorkshopList);
</script>

<style>
  .workshops-page {
    display: grid;
    gap: var(--space-6);
    padding: clamp(var(--space-3), 3vw, var(--space-5));
    border: 2px solid var(--color-accent);
    background-color: var(--color-surface);
    box-shadow: 0px 4px 0 var(--color-accent);
  }

  .workshop-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: var(--space-4);
    color: var(--color-accent);
  }
</style>
