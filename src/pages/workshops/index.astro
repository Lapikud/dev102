---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkshopCard from "../../components/WorkshopCard.astro";
import { getUpcomingWorkshops, getPastWorkshops } from "../../lib/workshops.ts";

const workshops = await getCollection("workshops");
const upcoming = getUpcomingWorkshops(workshops);
const past = getPastWorkshops(workshops);
---

<SiteLayout pageTitle="Workshops">
  <div class="workshops-page stagger">
    <header class="intro">
      <h1 class="terminal-token">~#DEV102/workshops</h1>
      <p>
        Hands-on sessions for learning, sharing, and making things together.
      </p>
    </header>

    <section aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="section-heading label">
        !#<span class="heading-title">WORKSHOPS</span> :
      </h2>
      {upcoming.length > 0 ? (
        <div class="workshop-list stagger">
          {upcoming.map((workshop, i) => (
            <WorkshopCard
              workshop={workshop}
              label={i === 0 ? ">#next" : undefined}
              isNext={i === 0}
              isUpcoming
            />
          ))}
        </div>
      ) : (
        <p class="panel panel-body label">
          No upcoming workshops yet. Check back soon.
        </p>
      )}
    </section>

    {past.length > 0 && (
      <section class="archive-section" aria-labelledby="past-heading">
        <h2 id="past-heading" class="section-heading label">
          !#archive :
        </h2>
        <div class="workshop-list stagger">
          {past.map((workshop) => (
            <WorkshopCard workshop={workshop} />
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>

<style>
  #upcoming-heading {
    color: var(--color-paper);
  }

  #upcoming-heading .heading-title {
    color: var(--color-orange-light);
  }

  .workshops-page {
    display: grid;
    gap: var(--space-6);
    padding: clamp(var(--space-3), 3vw, var(--space-5));
    border: 2px solid #ff9f36;
    background-color: var(--color-card);
    box-shadow: 0px 4px 0 #ff9f36;
  }

  .workshop-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4);
    color: var(--color-orange-light);
  }
</style>
