---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout pageTitle="Not found">
  <section class="intro stagger">
    <h1 class="terminal-token">~#404</h1>
    <p>This page doesn't exist. It may have moved, or the link is wrong.</p>
    <div class="actions">
      <a class="button button-primary" href="/">Home</a>
      <a class="button" href="/workshops/">All workshops</a>
    </div>
  </section>
</SiteLayout>
