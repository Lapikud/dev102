---
import BaseHead from "../components/BaseHead.astro";
import DotField from "../components/DotField.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { SITE_DESCRIPTION, THEMES } from "../consts";

interface Props {
  pageTitle?: string;
  description?: string;
}

const { pageTitle, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead pageTitle={pageTitle} description={description} />
    <script is:inline define:vars={{ themes: THEMES }}>
      const prefersDark = matchMedia("(prefers-color-scheme: dark)");
      let choice = null;
      try {
        choice = localStorage.getItem("theme") ?? "system";
      } catch (error) {
        console.warn(error);
      }
      function applyTheme(root) {
        let theme = choice;
        if (theme === "system")
          theme = prefersDark.matches ? "dark" : themes[0];
        if (themes.includes(theme)) {
          root.dataset.theme = theme;
          root.dataset.themeChoice = choice;
        } else {
          delete root.dataset.theme;
          delete root.dataset.themeChoice;
        }
      }
      const applyToPage = () => applyTheme(document.documentElement);
      applyToPage();
      prefersDark.addEventListener("change", applyToPage);
      document.addEventListener("theme-change", (event) => {
        choice = event.detail;
        applyToPage();
        try {
          localStorage.setItem("theme", choice);
        } catch (error) {
          console.warn(error);
        }
      });
      document.addEventListener("astro:before-swap", (event) =>
        applyTheme(event.newDocument.documentElement),
      );
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <DotField />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  #main-content {
    display: flex;
    flex-direction: column;
    width: calc(100% - var(--page-gutter) - var(--page-gutter));
    max-width: var(--content-page);
    min-height: 0;
    flex: 1;
    margin-inline: auto;
    padding-block: clamp(20px, 4vh, 64px);
    overflow: clip;
  }

  @media (prefers-reduced-motion: no-preference) {
    #main-content {
      animation: rise var(--duration-reveal) var(--ease-out) backwards;
    }
  }

  @media (min-width: 900px) and (max-height: 900px) {
    #main-content {
      padding-block: 20px;
    }
  }
</style>
