---
import { LAPIKUD_URL } from "../consts";

const year = new Date().getFullYear();
---

<footer class="site-footer on-ink" transition:persist="site-footer">
  <div class="footer-inner">
    <p>
      DEV102 is a workshop series by{" "}
      <a href={LAPIKUD_URL} target="_blank" rel="noreferrer">
        Lapikud
      </a>
      .
    </p>
    <small class="footer-mark">&copy; {year} Lapikud</small>
    <a class="footer-rss" href="/rss.xml">
      RSS feed
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  .footer-inner {
    display: flex;
    width: calc(100% - var(--page-gutter) - var(--page-gutter));
    max-width: var(--content-page);
    min-height: 80px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-inline: auto;
    font-size: 0.85rem;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-inner a,
  .footer-mark {
    color: var(--color-orange);
  }

  .footer-mark {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .footer-rss {
    align-self: center;
    margin-left: var(--space-3);
    color: var(--color-orange);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 899px) {
    .footer-inner {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-4);
    }

    .footer-inner p {
      flex-basis: 100%;
    }

    .footer-mark {
      margin-left: 0;
    }

    .footer-rss {
      margin-left: auto;
    }
  }

  @media (min-width: 900px) and (max-height: 900px) {
    .footer-inner {
      min-height: 56px;
    }
  }
</style>
