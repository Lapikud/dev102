---
import { Image } from "astro:assets";
import duck from "../assets/duck.png";
import ThemePicker from "./ThemePicker.astro";
---

<header class="site-header on-ink">
  <div class="site-nav">
    <a class="brand" href="/" aria-label="DEV102 home">
      <Image
        src={duck}
        alt="DEV102 duck mascot"
        width={80}
        height={52}
        loading="eager"
      />
      <span class="brand-token">~#DEV102</span>
    </a>
    <div class="header-actions">
      <nav class="nav-links" aria-label="Main navigation">
        <a
          href="/"
          aria-current={Astro.url.pathname === "/" ? "page" : undefined}
        >
          Home
        </a>
        <a
          href="/workshops/"
          aria-current={
            Astro.url.pathname.startsWith("/workshops") ? "page" : undefined
          }
        >
          Workshops
        </a>
      </nav>
      <ThemePicker />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: 1px solid rgb(255 255 255 / 18%);
  }

  .site-nav {
    display: flex;
    width: calc(100% - var(--page-gutter) - var(--page-gutter));
    max-width: var(--content-page);
    min-height: 84px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 0.8rem + 1vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .brand img {
    width: 72px;
    height: auto;
  }

  .brand-token {
    white-space: nowrap;
    color: var(--color-paper);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 40px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 40px);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .nav-links a {
    text-decoration: none;
  }

  .nav-links a[aria-current="page"] {
    color: var(--color-orange);
    text-decoration: underline;
    text-decoration-color: var(--color-orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 7px;
  }

  @media (max-width: 480px) {
    .site-nav {
      min-height: 72px;
      gap: 8px;
    }

    .brand {
      gap: 7px;
    }

    .brand img {
      width: 50px;
    }

    .header-actions,
    .nav-links {
      gap: 10px;
    }

    .nav-links {
      font-size: 0.65rem;
    }
  }

  @media (min-width: 900px) and (max-height: 900px) {
    .site-nav {
      min-height: 64px;
    }
  }
</style>
