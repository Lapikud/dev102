---
import type { CollectionEntry } from "astro:content";
import { formatShortWorkshopDate, formatSpeakers } from "../lib/workshops.ts";
import Tags from "./Tags.astro";

interface Props {
  workshop: CollectionEntry<"workshops">;
  isNext?: boolean;
}

const { workshop, isNext = false } = Astro.props;
const { title, description, date, location, tags, speakers } = workshop.data;
---

<article
  class="panel panel-body workshop-card lift"
  data-starts={date.toISOString()}
  data-next={isNext || undefined}
>
  <p class="label meta">
    <span class="marker">&gt;#next</span>
    <time datetime={date.toISOString()}>{formatShortWorkshopDate(date)}</time>
    <span aria-hidden="true">/</span>
    <span>{location}</span>
  </p>
  <h3 transition:name={`workshop-${workshop.id}`}>
    <a class="stretched-link" href={`/workshops/${workshop.id}/`}>
      {title}
    </a>
  </h3>
  <p class="label line-clamp speakers">{formatSpeakers(speakers)}</p>
  <p class="excerpt line-clamp">{description}</p>
  <Tags tags={tags} />
</article>

<style>
  .workshop-card {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: var(--space-2);
    padding: var(--space-4);
  }

  .workshop-card > :global(*) {
    margin: 0;
  }

  .workshop-card[data-next] {
    border-color: var(--color-accent);
    background-color: var(--color-page);
  }

  .workshop-card[data-next] h3 a {
    color: var(--color-accent);
  }

  .workshop-card:not([data-next]) .marker {
    display: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    white-space: pre-line;
  }

  h3 a {
    text-decoration: none;
  }

  .speakers {
    --lines: 2;
  }

  .excerpt {
    --lines: 2;
    font-size: 0.9rem;
  }

  .stretched-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
  }
</style>
