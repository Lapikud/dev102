---
import type { CollectionEntry } from "astro:content";
import { formatShortWorkshopDate } from "../lib/workshops.ts";

interface Props {
  workshop: CollectionEntry<"workshops">;
  label?: string;
  isNext?: boolean;
  isUpcoming?: boolean;
}

const { workshop, label, isNext = false, isUpcoming = false } = Astro.props;
const { title, date, location, tags } = workshop.data;
---

<article
  class:list={[
    "panel",
    "panel-body",
    "workshop-card",
    "lift",
    { "next-workshop": isNext, "upcoming-workshop": isUpcoming },
  ]}
>
  <p class="label meta">
    {label && <span class="marker">{label}</span>}
    <time datetime={date.toISOString()}>{formatShortWorkshopDate(date)}</time>
    <span aria-hidden="true">/</span>
    <span>{location}</span>
  </p>
  <h3 transition:name={`workshop-${workshop.id}`}>
    <a class="stretched-link" href={`/workshops/${workshop.id}/`}>
      {title}
    </a>
  </h3>
  {tags && tags.length > 0 && (
    <ul class="tags" aria-label="Topics">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .workshop-card {
    position: relative;
    padding: var(--space-4);
  }

  .next-workshop {
    border-color: #ff9f36;
    background-color: var(--color-lighter-ink);
    color: var(--color-paper);
  }

  .next-workshop .marker,
  .next-workshop h3 a {
    color: #ff9f36;
  }

  .upcoming-workshop:hover,
  .upcoming-workshop:focus-within {
    background-color: #ff9f36;
    color: var(--color-ink);
  }

  .upcoming-workshop {
    --lift-shadow-color: var(--color-paper);
    padding: var(--space-3);
  }

  .upcoming-workshop:hover h3 a,
  .upcoming-workshop:focus-within h3 a {
    color: var(--color-ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .marker {
    padding: 0 var(--space-1);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  h3 {
    margin-bottom: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    white-space: pre-line;
  }

  h3 a {
    text-decoration: none;
  }

  .stretched-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
  }
</style>
