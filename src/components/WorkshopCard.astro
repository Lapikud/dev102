---
import type { CollectionEntry } from "astro:content";
import { formatShortWorkshopDate } from "../lib/workshops.ts";

interface Props {
  workshop: CollectionEntry<"workshops">;
  label?: string;
}

const { workshop, label } = Astro.props;
const { title, date, location, tags } = workshop.data;
---

<article class="panel panel-body workshop-card lift">
  <p class="label meta">
    {label && <span class="marker">{label}</span>}
    <time datetime={date.toISOString()}>{formatShortWorkshopDate(date)}</time>
    <span aria-hidden="true">/</span>
    <span>{location}</span>
  </p>
  <h3 transition:name={`workshop-${workshop.id}`}>
    <a class="stretched-link" href={`/workshops/${workshop.id}/`}>
      {title}
    </a>
  </h3>
  {tags && tags.length > 0 && (
    <ul class="tags" aria-label="Topics">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .workshop-card {
    position: relative;
    padding: var(--space-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .marker {
    padding: 0 var(--space-1);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  h3 {
    margin-bottom: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    white-space: pre-line;
  }

  h3 a {
    text-decoration: none;
  }

  .stretched-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
  }
</style>
