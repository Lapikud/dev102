---
import "../styles/global.css";
import { SEO } from "astro-seo";
import redHatDisplay from "../assets/fonts/red-hat-display-latin.woff2?url";
import jetBrainsMono from "../assets/fonts/jetbrains-mono-latin.woff2?url";
import syncopateBold from "../assets/fonts/syncopate-bold-latin.woff2?url";
import { SOCIAL_CARD_SIZE } from "../lib/brand-images.ts";
import { SITE_TITLE } from "../consts";

interface Props {
  pageTitle?: string;
  description: string;
}

const { pageTitle, description } = Astro.props;
const aboveTheFoldFonts = [redHatDisplay, jetBrainsMono, syncopateBold];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialCardURL = new URL("og.png", Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{aboveTheFoldFonts.map((font) => (
  <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
))}
<SEO
  title={pageTitle}
  titleTemplate={`%s | ${SITE_TITLE}`}
  titleDefault={SITE_TITLE}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      title: pageTitle ?? SITE_TITLE,
      type: "website",
      image: socialCardURL.href,
      url: canonicalURL,
    },
    optional: { siteName: SITE_TITLE, description },
    image: {
      width: SOCIAL_CARD_SIZE.width,
      height: SOCIAL_CARD_SIZE.height,
      alt: "The DEV102 badge: the duck mascot coding at a laptop, with the Lapikud logo",
    },
  }}
  twitter={{ card: "summary_large_image" }}
/>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} Workshops`}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
